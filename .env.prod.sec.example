# Desktop SECRETS — PROD.  Copy to `.env.prod.sec`, fill in, then:
#   npm run env:encrypt:prod    (commits .env.prod.sec.enc; plaintext stays local)

# Tauri updater signing — the SAME keypair as dev (the updater pubkey in
# tauri.conf.json is fixed, so the private key must match across envs).
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
