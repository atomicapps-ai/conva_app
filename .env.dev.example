# Desktop config — DEV.  Copy to `.env.dev`, fill in the <…> placeholders,
# then:  npm run env:encrypt:dev   (commits .env.dev.enc; plaintext stays local)
#
# Consumed two ways:
#   • local dev — `npm run env:decrypt:dev`, source these, run `npm run tauri:gpu`
#     (auth.rs reads CONVA_SUPABASE_* from the runtime env)
#   • CI dev build — .github/workflows/dev-build.yml decrypts + bakes them into
#     the binary via option_env!, so a distributed dev installer points here

# --- Supabase auth backend (DEV = conva-core-dev) -------------------------
# Create conva-core-dev first: ../conva_core/docs/guides/dev-environment-setup.md
CONVA_SUPABASE_URL=https://<conva-core-dev-project-ref>.supabase.co
CONVA_SUPABASE_ANON_KEY=<conva-core-dev-anon-key>

# OAuth return deep-link. The hosted callback page forwards ?code into the app;
# it is Supabase-project-agnostic, so dev reuses the same page as prod. Leave
# unset to use the built-in default (https://getconva.com/callback → conva://).
# CONVA_AUTH_REDIRECT_URL=conva://auth/callback
