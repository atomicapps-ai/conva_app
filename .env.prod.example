# Desktop config — PROD.  Copy to `.env.prod`, fill in the <…> placeholders,
# then:  npm run env:encrypt:prod   (commits .env.prod.enc; plaintext stays local)
#
# PROD points at live conva-core. These match the DEFAULT_* baked into
# src-tauri/src/auth.rs today (project ref hbxftjyooblxiiapaeei) — so the prod
# release build works with or without them; committing them here just keeps
# both environments described in one place.

CONVA_SUPABASE_URL=https://hbxftjyooblxiiapaeei.supabase.co
CONVA_SUPABASE_ANON_KEY=<conva-core-prod-anon-key>

# CONVA_AUTH_REDIRECT_URL=conva://auth/callback
