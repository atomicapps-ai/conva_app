# conva_app — DEV secrets (never commit the plaintext; `npm run env:encrypt:dev`).
# Updater signing key: `npm run tauri signer generate -- -w env\updater.key`, paste
# the PRIVATE key here and the PUBLIC key into tauri.conf.json plugins.updater.pubkey.
# Dev and prod must share one keypair while tauri.conf.json carries a single pubkey.
TAURI_SIGNING_PRIVATE_KEY=<minisign private key, base64>
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
