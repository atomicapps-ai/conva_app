# Node
node_modules/
dist/
dist-web/
# TypeScript incremental-build cache — rewritten on every build; tracking it
# guarantees permanent dirty-tree/merge churn on every machine.
tsconfig.tsbuildinfo

# Rust
target/

# Models are fetched on first run, never committed
models/

# Env / secrets — plaintext env files never get committed…
.env
.env.*
.dev.vars
env/master.key
# …but the passphrase-encrypted secrets file is meant to be committed.
!*.secrets.enc
# …and the env-toolkit encrypted twins + example templates are committed too
# (see env/README.md). The 32-byte master key stays local / shared out-of-band.
!.env.*.enc
!.env.*.example

# Editor/OS noise
.DS_Store
Thumbs.db
*.log

# Tauri generated artifacts
src-tauri/gen/

# Brainstorming/design-companion scratch (not part of the shipped app)
.superpowers/
