{
  "name": "conva",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:web": "vite --port 1430",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "vite preview --outDir dist-web --port 1431",
    "typecheck": "tsc -b",
    "version:set": "node scripts/version.mjs set",
    "version:stamp": "node scripts/version.mjs stamp",
    "version:check": "node scripts/version.mjs check",
    "version:get": "node scripts/version.mjs get",
    "changelog:generate": "git-cliff -o CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased --strip header",
    "tauri": "tauri",
    "tauri:gpu": "tauri dev --features gpu-vulkan",
    "tauri:gpu:cuda": "tauri dev --features gpu-cuda",
    "tauri:gpu:metal": "tauri dev --features gpu-metal",
    "tauri:build:gpu": "tauri build --features gpu-vulkan",
    "start:dev": "node env/cli.mjs run dev -- npm run tauri:gpu",
    "start:prod": "node env/cli.mjs run prod -- npm run tauri:gpu",
    "web:dev": "node env/cli.mjs run dev -- npm run dev:web",
    "web:prod": "node env/cli.mjs run prod -- npm run dev:web",
    "env:keygen": "node env/cli.mjs keygen",
    "env:encrypt:dev": "node env/cli.mjs encrypt dev",
    "env:encrypt:prod": "node env/cli.mjs encrypt prod",
    "env:decrypt:dev": "node env/cli.mjs decrypt dev",
    "env:decrypt:prod": "node env/cli.mjs decrypt prod",
    "env:print:dev": "node env/cli.mjs print dev",
    "env:print:prod": "node env/cli.mjs print prod"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "html2canvas": "^1.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^25.0.1",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
