{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "conva",
  "version": "../package.json",
  "identifier": "ai.atomicapps.conva",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "conva",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Real-time strategic intelligence ally",
    "longDescription": "conva is a strategic intelligence ally — it transcribes both sides of a call live and grounds Ally's answers in your own reference library, all on your machine.",
    "icon": [
      "icons/desktop/icons/conva-icon-32.png",
      "icons/desktop/icons/conva-icon-128.png",
      "icons/desktop/icons/conva-icon-256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["conva"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNkZEMUE1NTM2NEI4MDIKUldRQ3VHUlRwZEZ2LzQwdHJiV0VxWjVnNEE0L0ZuclEra093ZUFXajZqL3ZkNU00ZEZhQkF3MXkK",
      "endpoints": [
        "https://github.com/atomicapps-ai/conva_releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
