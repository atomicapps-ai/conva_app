{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "conva",
  "version": "0.1.0",
  "identifier": "ai.atomicapps.conva",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "conva",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Real-time strategic intelligence ally",
    "longDescription": "conva is a strategic intelligence ally — it transcribes both sides of a call live and grounds Ally's answers in your own reference library, all on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNzhGRTlEM0E2Mzc2OTQKUldTVWRtTTZuZjU0RUtCZW9iYTFNYytjK3pFaWxrY0svQjB2RGJweDV2K0hBZ1BncUY0ZnVnWFUK",
      "endpoints": [
        "https://github.com/atomicapps-ai/conva/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
